APP_NAME="Health Tracker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://health.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The reporting timezone — which calendar day a datapoint counts toward.
# Laravel itself stays on UTC; this is separate on purpose. The device offset
# observed in every captured payload is +0200.
#
# CHANGING THIS IS A MIGRATION, NOT A CONFIG EDIT: `health_metrics.local_date`
# and `meals.local_date` are Postgres generated columns with the zone baked into
# their DDL, and every daily_summaries row would need rebuilding. See
# config/health.php.
HEALTH_TIMEZONE=Europe/Amsterdam

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Postgres 18 — service name on the compose network, no host port published.
# NB: this file doubles as docker compose's env file, so DB_* is read by both
# Laravel and the postgres container. Keep the password alphanumeric: compose
# would try to interpolate a `$` in it.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=health_tracker
DB_USERNAME=health_tracker
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Step 2: the ingest parser runs on the queue. The `horizon` compose service
# is the worker; the ingest POST only banks bytes and dispatches.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis

# Redis holds the queue and the cache and is reachable from every container on
# the compose bridge network, so it wants a password of its own. This value is
# read TWICE: by Laravel, and by the `redis` service in docker-compose.yml,
# which passes it to `--requirepass`. That is what keeps the two in step.
#
# EMPTY (or the literal `null`) MEANS NO PASSWORD, in both places — the compose
# services special-case both, because Laravel's env() reads `null` as PHP null
# and compose would otherwise set the four characters n-u-l-l as the password.
# So leaving this alone is exactly the unauthenticated redis that was here
# before; nothing breaks by omission.
#
# To turn it on: put a value here, then restart redis AND app/horizon/scheduler
# TOGETHER — redis starts demanding the password the moment it is recreated, and
# a php-fpm still holding the old config answers every request with NOAUTH.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="health@example.com"
MAIL_FROM_NAME="Health Tracker"

# Shared secret for POST /api/ingest — the value Health Auto Export sends in
# its `X-API-Key` header. Generate with: openssl rand -hex 32
INGEST_API_KEY=

# Horizon dashboard access outside `local`. EMPTY MEANS DENY — an unset secret
# is never read as "no secret required". Leave unset in production: the host
# vhost 404s /horizon regardless, and this only unlocks a tunnelled look at
# 127.0.0.1:3083. Generate with: openssl rand -hex 32
HORIZON_DASHBOARD_TOKEN=

# --- Step 3: the UI ---------------------------------------------------------

# Session cookies. The app is HTTPS-only behind Cloudflare + host nginx, so the
# cookie has no business travelling over plain http. `lax` keeps the login
# redirect working while blocking cross-site POSTs.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# The single account, created by `php artisan db:seed --class=SingleUserSeeder`.
# Leave SEED_USER_PASSWORD unset: the seeder then GENERATES a strong password
# and prints it once. Set it only to deliberately rotate the password.
SEED_USER_EMAIL=user@example.com
SEED_USER_NAME=Demo User
SEED_USER_PASSWORD=

# --- Step 5: the vision pipeline --------------------------------------------

# Anthropic API key for the meal-photo analysis call. Never commit a real one:
# this file is the template, the value lives in .env only.
#
# TEMP: Reflection's key — replace with dedicated key
ANTHROPIC_API_KEY=

# The exact model string, recorded on every vision_requests row so a model
# change never rewrites what produced the rows that came before it.
VISION_MODEL=claude-opus-5

# Everything else about the pipeline (token ceiling, timeouts, image sizes,
# photo retention) has a default in config/health.php -> vision and only needs
# an entry here to move it.

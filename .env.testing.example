# Testing environment — used by `php artisan test` and by any artisan command
# run with `--env=testing`.
#
# ---------------------------------------------------------------------------
# THIS FILE EXISTS TO STOP `--env=testing` REACHING PRODUCTION
#
# Laravel falls back to `.env` when the file for the named environment is
# missing. Without this file, `php artisan migrate --env=testing` did not run
# against a test database at all — it ran against `.env`, which is
# PRODUCTION. It looked exactly like a safe command and it was not.
#
# So the one line that matters here is DB_DATABASE, and it is the test
# database. `phpunit.xml` sets the same value; that redundancy is the point,
# because artisan commands do not read phpunit.xml.
# ---------------------------------------------------------------------------
#
# THIS is the template. Copy it to `.env.testing` (which is NOT committed),
# fill in DB_PASSWORD to match `.env`, and generate a key:
#
#   docker compose exec app cp .env.testing.example .env.testing
#   docker compose exec app php artisan key:generate --env=testing
#
# The database must exist first:
#
#   docker compose exec postgres sh -c \
#     'psql -U $POSTGRES_USER -d postgres -c "CREATE DATABASE health_tracker_test OWNER health_tracker;"'
# APP_KEY is generated fresh for testing — it decrypts nothing in production.

APP_NAME="Health Tracker"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=health_tracker_test
DB_USERNAME=health_tracker
DB_PASSWORD=
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
MAIL_MAILER=array
MAIL_FROM_ADDRESS="health@example.com"
MAIL_FROM_NAME="Health Tracker"
INGEST_API_KEY=testing-ingest-key-not-a-real-secret
HEALTH_TIMEZONE=Europe/Amsterdam
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
ANTHROPIC_API_KEY=sk-ant-testing-not-a-real-key
VISION_MODEL=claude-opus-5

# See docs/rationale-app.md § "Static analysis" for why on the settings
# below: Larastan, the empty baseline, level 8, one process,
# checkModelProperties, and report_unmatched_ignored_errors.
# Run: scripts/ci.sh --static-only.

includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Correctness checks, not annotation completeness — see docs/rationale-app.md § "Static analysis".
    level: 8

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests

    excludePaths:
        analyseAndScan:
            # Generated by `package:discover` at install time; not source.
            - bootstrap/cache

    # One process: parallel workers can OOM here and undercount errors.
    parallel:
        maximumNumberOfProcesses: 1

    # Needed for generated/cast columns like $meal->eaten_at.
    checkModelProperties: true
